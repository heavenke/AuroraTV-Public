/* Aurora libmpv/libplacebo bridge. LGPL-2.1-or-later.
 * All Dolby reshaping, nonlinear matrices and PQ operations are generated by
 * the linked LGPL libplacebo implementation, from the current decoded frame.
 * Afterwards mpv's existing color-management pass maps BT.2020/PQ to the target.
 */
#include <ctype.h>

static bool aurora_dovi_uniform_supported(const struct pl_var *v)
{
    return v->type == PL_VAR_FLOAT && v->dim_v >= 1 && v->dim_v <= 4 &&
           (v->dim_m == 1 || (v->dim_m == v->dim_v && v->dim_m <= 3)) &&
           v->dim_a >= 1 && v->dim_a <= 64;
}

static void aurora_dovi_uniform(struct gl_shader_cache *sc, char *name,
                               const struct pl_var *v, const float *data)
{
    gl_sc_uniform_dynamic(sc);
    if (v->dim_m == 2) {
        gl_sc_uniform_mat2(sc, name, false, (float *)data);
    } else if (v->dim_m == 3) {
        gl_sc_uniform_mat3(sc, name, false, (float *)data);
    } else {
        switch (v->dim_v) {
        case 1: gl_sc_uniform_f(sc, name, data[0]); break;
        case 2: gl_sc_uniform_vec2(sc, name, (float *)data); break;
        case 3: gl_sc_uniform_vec3(sc, name, (float *)data); break;
        case 4: gl_sc_uniform_vec4(sc, name, data); break;
        }
    }
}

/* The old renderer has no uniform arrays. Expand each array into individual
 * dynamic uniforms plus a lookup function. Coefficients remain uniforms:
 * changing RPU values does not create a new shader or compile it every frame.
 * Function lookup also avoids fragile dynamic uniform-array indexing on GLES.
 */
static char *aurora_dovi_rewrite_array(void *ctx, const char *glsl,
                                      const char *name)
{
    char *code = talloc_strdup(ctx, glsl);
    size_t n = strlen(name);
    for (char *at = code; (at = strstr(at, name)); at += n) {
        bool boundary = at == code || !(isalnum((unsigned char)at[-1]) || at[-1] == '_');
        if (!boundary || at[n] != '[')
            continue;
        char *open = at + n;
        int depth = 1;
        for (char *end = open + 1; *end; end++) {
            if (*end == '[') depth++;
            if (*end == ']' && --depth == 0) {
                *open = '(';
                *end = ')';
                break;
            }
        }
    }
    return code;
}

static bool aurora_dovi_emit_shader(struct gl_shader_cache *sc,
                                    const struct pl_shader_res *res)
{
    if (!res || res->input != PL_SHADER_SIG_COLOR ||
        res->output != PL_SHADER_SIG_COLOR || res->num_descriptors ||
        res->num_vertex_attribs || res->num_constants)
        return false;
    for (int i = 0; i < res->num_variables; i++) {
        if (!aurora_dovi_uniform_supported(&res->variables[i].var))
            return false;
    }
    void *tmp = talloc_new(NULL);
    char *code = talloc_strdup(tmp, res->glsl);
    for (int i = 0; i < res->num_variables; i++) {
        const struct pl_shader_var *sv = &res->variables[i];
        struct pl_var var = sv->var;
        const float *data = sv->data;
        if (var.dim_a == 1) {
            aurora_dovi_uniform(sc, (char *)var.name, &var, data);
            continue;
        }
        char *rewritten = aurora_dovi_rewrite_array(tmp, code, var.name);
        code = rewritten;
        struct pl_var scalar = var;
        scalar.dim_a = 1;
        const char *type = pl_var_glsl_type_name(scalar);
        for (int j = 0; j < var.dim_a; j++) {
            char *element = talloc_asprintf(tmp, "%s_v%d", var.name, j);
            aurora_dovi_uniform(sc, element, &scalar,
                               data + j * var.dim_v * var.dim_m);
        }
        gl_sc_haddf(sc, "%s %s(int idx) {\n", type, var.name);
        for (int j = 0; j < var.dim_a - 1; j++)
            gl_sc_haddf(sc, "if (idx == %d) return %s_v%d;\n", j, var.name, j);
        gl_sc_haddf(sc, "return %s_v%d; }\n", var.name, var.dim_a - 1);
    }
    gl_sc_hadd(sc, code);
    gl_sc_addf(sc, "color = %s(color);\n", res->name);
    talloc_free(tmp);
    return true;
}

#ifndef AURORA_DOVI_BRIDGE_ONLY
static bool aurora_pass_dolby_vision(struct gl_video *p,
                                    const struct mp_csp_params *cparams)
{
    const struct mp_image *frame = p->image.mpi;
    if (!frame || frame->params.no_dovi || !frame->dovi ||
        frame->params.repr.sys != PL_COLOR_SYSTEM_DOLBYVISION)
        return false;

    struct pl_shader_params params = {
        .id = 217,
        .glsl = {.version = p->ra->glsl_version, .gles = p->ra->glsl_es},
        .dynamic_constants = true,
    };
    if (!p->aurora_dovi_shader)
        p->aurora_dovi_shader = pl_shader_alloc(NULL, &params);
    else
        pl_shader_reset(p->aurora_dovi_shader, &params);

    struct pl_color_repr repr = frame->params.repr;
    repr.dovi = (const struct pl_dovi_metadata *)frame->dovi->data;
    // pass_read_video has already normalized high-bit-depth samples into the
    // legacy 8-bit texture domain. libplacebo's default 255/256 factor exactly
    // recovers code / 2^BL_bit_depth before RPU reshaping.
    repr.bits = (struct pl_bit_encoding){0};
    struct pl_color_adjustment adjustment = pl_color_adjustment_neutral;
    adjustment.brightness = cparams->brightness;
    adjustment.contrast = cparams->contrast;
    adjustment.hue = cparams->hue;
    adjustment.saturation = cparams->saturation;
    pl_shader_decode_color(p->aurora_dovi_shader, &repr, &adjustment);
    if (!aurora_dovi_emit_shader(p->sc, pl_shader_finalize(p->aurora_dovi_shader))) {
        MP_ERR(p, "Dolby Vision reshaping shader unavailable.\n");
        // Never silently show the incompatible base layer as successful mapping.
        gl_sc_add(p->sc, "#error AURORA_DOLBY_VISION_MAPPING_UNAVAILABLE\n");
        return true;
    }
    p->image_params.color = frame->params.color;
    pass_describe(p, "Dolby Vision RPU reshaping (libplacebo)");
    return true;
}
#endif
