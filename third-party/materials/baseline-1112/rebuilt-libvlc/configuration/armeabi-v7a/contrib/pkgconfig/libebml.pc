prefix=/root/.cache/aurora-vlc-lgpl/source/vlc/contrib/arm-linux-androideabi
exec_prefix=${prefix}
libdir=${prefix}/lib
includedir=${prefix}/include

Name:        libebml
Description: Library for parsing EBML data structures
Version:     1.4.5
Libs:        -L${libdir} -lebml
Cflags:      -I${includedir}  -DEBML_STATIC_DEFINE
