prefix=/root/.cache/aurora-vlc-lgpl/source/vlc/contrib/arm-linux-androideabi
bindir=${prefix}/bin
mandir=${prefix}/share/man
docdir=${prefix}/share/doc/openjpeg
libdir=${prefix}/lib
includedir=${prefix}/include/openjpeg-2.5

Name: openjp2
Description: JPEG2000 library (Part 1 and 2)
URL: http://www.openjpeg.org/
Version: 2.5.4
Libs:  -L${libdir} -lopenjp2   -lm -pthread
Cflags:  -I${includedir}  -DOPJ_STATIC
Requires:  
