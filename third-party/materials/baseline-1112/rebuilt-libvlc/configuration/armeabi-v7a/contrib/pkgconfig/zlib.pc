prefix=/root/.cache/aurora-vlc-lgpl/source/vlc/contrib/arm-linux-androideabi
exec_prefix=/root/.cache/aurora-vlc-lgpl/source/vlc/contrib/arm-linux-androideabi
libdir=${exec_prefix}/lib
sharedlibdir=${exec_prefix}/lib
includedir=${exec_prefix}/include

Name: zlib
Description: zlib compression library
Version: 1.3.2
License: Zlib

Requires:
Libs: -L${libdir} -L${sharedlibdir} -lz
Cflags: -I${includedir}
