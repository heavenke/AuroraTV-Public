prefix=/root/.cache/aurora-vlc-lgpl/source/vlc/contrib/aarch64-linux-android
includedir=${prefix}/include
libdir=${prefix}/lib

Name: harfbuzz
Description: HarfBuzz text shaping library
Version: 11.5.0
Requires: freetype2 >=  12.0.6
Libs: -L${libdir} -lharfbuzz -pthread -lm
Cflags: -I${includedir}/harfbuzz -pthread
