prefix=/root/.cache/aurora-vlc-lgpl/source/vlc/contrib/aarch64-linux-android
includedir=${prefix}/include
libdir=${prefix}/lib

Name: libbluray
Description: library supporting Blu-ray playback
Version: 1.4.0
Requires: freetype2, libxml-2.0 >=  2.6
Libs: -L${libdir} -lbluray -pthread
Cflags: -I${includedir} -pthread
