prefix=/root/.cache/aurora-vlc-lgpl/source/vlc/contrib/aarch64-linux-android
exec_prefix=${prefix}
libdir=${exec_prefix}/lib
includedir=${prefix}/include

Name: libupnp
Description: Linux SDK for UPnP Devices
Version: 1.14.20
Libs: -pthread  -L${libdir} -lupnp -lixml
Libs.private: 
Cflags: -pthread -I${includedir}/upnp

