prefix=/root/.cache/aurora-vlc-lgpl/source/vlc/contrib/aarch64-linux-android
exec_prefix=${prefix}
libdir=${exec_prefix}/lib
includedir=${prefix}/include

Name: libssh2
URL: https://libssh2.org/
Description: Library for SSH-based communication
Version: 1.11.1
Requires: libgcrypt
Requires.private: libgcrypt
Libs: -L${libdir} -lssh2 -lgcrypt -lgpg-error
Libs.private: -lgcrypt -lgpg-error
Cflags: -I${includedir}
