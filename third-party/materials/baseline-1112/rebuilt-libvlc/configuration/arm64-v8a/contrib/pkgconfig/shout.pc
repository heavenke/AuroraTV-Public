# libshout pkg-config source file

prefix=/root/.cache/aurora-vlc-lgpl/source/vlc/contrib/aarch64-linux-android
exec_prefix=${prefix}
libdir=/root/.cache/aurora-vlc-lgpl/source/vlc/contrib/aarch64-linux-android/lib
includedir=/root/.cache/aurora-vlc-lgpl/source/vlc/contrib/aarch64-linux-android/include
cppflags= -I/root/.cache/aurora-vlc-lgpl/source/vlc/contrib/aarch64-linux-android/include
cflags_only=

Name: Shout
Description: Audio streaming library for icecast encoders
Version: 2.4.6
Libs:  -L${libdir} -lshout 
Cflags:  -I${includedir}   
Requires:   ogg, vorbis, theora, speex
