=16384 --end-no-unused-arguments -DNDEBUG  -fexceptions -frtti --start-no-unused-arguments -Wl,-z,max-page-size=16384 --end-no-unused-arguments -fdata-sections -ffunction-sections' 'PKG_CONFIG_LIBDIR=/root/.cache/aurora-vlc-lgpl/source/vlc/contrib/aarch64-linux-android/lib/pkgconfig' $ac_configure_extra_args --no-create --no-recursion
  shift
